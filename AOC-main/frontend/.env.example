# API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000/ws

# UI
# Controls the text animation sequence: tilt -> move up -> straighten
# Sequence values (comma-separated): tilt, moveUp, straighten
NEXT_PUBLIC_UI_ANIMATION_SEQUENCE=tilt,moveUp,straighten
NEXT_PUBLIC_UI_ANIMATION_DURATION_MS=1200
NEXT_PUBLIC_UI_ANIMATION_EASING=cubic-bezier(0.22,1,0.36,1)
# Degrees to tilt the text at start (positive = clockwise)
NEXT_PUBLIC_UI_TEXT_TILT_DEG=15

# Trigger the animation when the page reloads (true/false)
NEXT_PUBLIC_UI_ANIMATION_ON_RELOAD=true
